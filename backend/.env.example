SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-secret-key

ENVIRONMENT=development
AUTO_CONFIRM_EMAIL=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

RATE_LIMIT_PER_MINUTE=120
WEBHOOK_SECRET=change-me-min-16-chars
INTERNAL_JOB_TOKEN=change-me-worker-token
OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Optional Postgres URLs for replicas / schema apply scripts
# DATABASE_URL=postgresql://...
# DATABASE_READ_URL=postgresql://...
